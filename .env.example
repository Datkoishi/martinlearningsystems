NODE_ENV=development
BACKEND_PORT=3000
FRONTEND_PORT=5173

MYSQL_HOST=mysql
MYSQL_PORT=3307
MYSQL_DATABASE=mls_db
MYSQL_USER=mls_user
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root

CLIENT_ORIGIN=http://localhost:5173

# Chỉ bật sau khi migration identity, account bootstrap và HTTPS/cookie đã sẵn sàng.
ENABLE_IMPORT_API=false
IMPORT_STORAGE_PATH=.data/imports

AUTH_SESSION_HOURS=8
# false chỉ dành cho local HTTP; production HTTPS phải là true.
COOKIE_SECURE=false

# Số reverse proxy tin cậy trước backend. Local/direct = 0; production sau đúng một proxy = 1.
TRUST_PROXY=0
# Backend chuyển readiness sang not-ready rồi chờ tối đa thời gian này khi SIGTERM/SIGINT.
SHUTDOWN_GRACE_MS=10000

# Runner migration dùng advisory lock và checksum; Docker backend đặt path này thành /app/database/init.
MIGRATIONS_PATH=../database/init
MIGRATION_LOCK_TIMEOUT_SECONDS=30
MIGRATION_ACTOR=local-operator

# Media published mặc định tiếp tục đọc archive. Chỉ bật sau khi bucket/credential/policy đã sẵn sàng.
OBJECT_STORAGE_ENABLED=false
# Để trống khi dùng endpoint mặc định của AWS S3; S3-compatible production phải dùng HTTPS.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=eduassess-media
OBJECT_STORAGE_REGION=ap-southeast-1
OBJECT_STORAGE_KEY_PREFIX=eduassess/media
# Custom endpoint local (MinIO) thường cần true; endpoint AWS mặc định dùng false.
OBJECT_STORAGE_FORCE_PATH_STYLE=false
# Giữ true trong giai đoạn rollout; chỉ tắt sau cửa sổ xác minh và rehearsal rollback.
OBJECT_STORAGE_ARCHIVE_FALLBACK=true
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
MEDIA_PROMOTION_ACTOR=local-operator

# Metrics dùng listener riêng, mặc định chỉ bind loopback và tắt. Khi bật, token phải >= 32 ký tự.
# Production dùng METRICS_BEARER_TOKEN_FILE qua Docker secret, không lưu token trong env file.
METRICS_ENABLED=false
METRICS_PORT=9464
METRICS_BIND_ADDRESS=127.0.0.1
METRICS_BEARER_TOKEN=

# Opt-in bằng: docker compose --profile backup up -d
# Production phải map backup_data sang encrypted/off-site storage và giám sát health của service backup.
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
BACKUP_MAX_AGE_SECONDS=90000
BACKUP_STALE_LOCK_SECONDS=21600
BACKUP_RUN_ON_START=true
BACKUP_HEALTH_START_PERIOD=10m
