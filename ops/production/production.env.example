# Copy this file outside version control, set real values, and pass it with --env-file.
NODE_ENV=production
CLIENT_ORIGIN=https://eduassess.example
COOKIE_SECURE=true
TRUST_PROXY=1
ENABLE_IMPORT_API=false

MYSQL_DATABASE=mls_db
MYSQL_USER=mls_user
MYSQL_PASSWORD_SECRET_FILE=/secure/eduassess/mysql-password
MYSQL_ROOT_PASSWORD_SECRET_FILE=/secure/eduassess/mysql-root-password

TLS_CERTIFICATE_SECRET_FILE=/secure/eduassess/tls-certificate.pem
TLS_PRIVATE_KEY_SECRET_FILE=/secure/eduassess/tls-private-key.pem
METRICS_BEARER_TOKEN_SECRET_FILE=/secure/eduassess/metrics-bearer-token
ALERT_WEBHOOK_URL_SECRET_FILE=/secure/eduassess/alert-webhook-url

# Public edge ports. Bind these to 80/443 after validating on a staging host.
PRODUCTION_HTTP_PORT=80
PRODUCTION_HTTPS_PORT=443

BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
BACKUP_MAX_AGE_SECONDS=90000
BACKUP_STALE_LOCK_SECONDS=21600
BACKUP_RUN_ON_START=true
BACKUP_HEALTH_START_PERIOD=10m
