{
  "name": "mls-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "auth:create-user": "node scripts/create-user.js --password-stdin",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:status": "node scripts/migrate.js --status",
    "media:status": "node scripts/media-storage.js status",
    "media:promote": "node scripts/media-storage.js promote",
    "media:rollback": "node scripts/media-storage.js rollback",
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "mysql2": "^3.14.0",
    "socket.io": "^4.8.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "yazl": "^3.3.1"
  }
}
